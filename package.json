{
  "name": "dsh-py-doctor",
  "version": "0.1.5",
  "description": "DSH plugin: deterministic, offline Python/Django production-report diagnostics — traceback root cause, pytest summaries, unapplied migrations, N+1 SQL, manage.py check --deploy and Celery backlog. Does not execute Python, start subprocesses or touch the network.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run build && npm run check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin",
    "deterministic",
    "offline",
    "local-first",
    "no-network",
    "read-only",
    "python",
    "python3",
    "traceback",
    "exception",
    "stack-trace",
    "pytest",
    "django",
    "migrations",
    "n-plus-one",
    "orm",
    "sql",
    "celery",
    "django-checks",
    "deployment",
    "diagnostics",
    "production-diagnostics",
    "troubleshooting"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ax2/dsh-py-doctor.git"
  },
  "homepage": "https://zicode.com/software/",
  "bugs": {
    "url": "https://github.com/ax2/dsh-py-doctor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "24",
    "typescript": "5.9.3"
  }
}
